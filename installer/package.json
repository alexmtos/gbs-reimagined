{
  "name": "gbs-reimagined-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser installer for GBS Reimagined: ESP Web Tools and Improv Wi-Fi (ADR 0012)",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite build && vite preview --host localhost --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "esp-web-tools": "10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
